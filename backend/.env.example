# RescueRoute Backend Environment Variables Template
# Copy to .env for local configuration or configure in Render Dashboard
SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-pooler-host>.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=<db-username>
SPRING_DATASOURCE_PASSWORD=<db-password>
PORT=8080
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=your-secure-jwt-secret-key-at-least-256-bits-long-change-in-prod
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=https://rescueroute.vercel.app,http://localhost:5173
OSRM_BASE_URL=https://router.project-osrm.org
OVERPASS_API_URL=https://overpass-api.de/api/interpreter


