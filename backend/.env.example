# RescueRoute Backend Environment Variables Template
# Copy to your local environment configuration or set in your environment
SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-host>/neondb
SPRING_DATASOURCE_USERNAME=<db-username>
SPRING_DATASOURCE_PASSWORD=<db-password>
PORT=8080
JWT_SECRET=your-secure-jwt-secret-key-at-least-256-bits-long
JWT_EXPIRATION_MS=86400000

